# Copy this file to ".env" (same folder) and fill in your Alpaca PAPER keys.
# Get them free at https://alpaca.markets -> Paper Trading -> API Keys.
# These are read only by the local server and are never sent to the browser.

APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Optional: change the port the app runs on (default 4000).
# PORT=4000
