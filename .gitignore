# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build
/dist-app

# secrets — NEVER commit
.env.local
.env.development.local
.env.test.local
.env.production.local

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# editor
.vscode/
.idea/

# lead inbox data (might contain real leads)
leads-inbox.json

# Claude Code launch config (per-machine)
.claude/launch.json

# Local voice clone server — Python venv + cached models (~3-4 GB, per-machine)
/tools/voice-clone-server/venv/
/tools/voice-clone-server/__pycache__/
/tools/voice-clone-server/*.pyc
.vercel
