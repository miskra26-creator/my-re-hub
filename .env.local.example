# Copy this file to .env.local and fill in your real keys.
# .env.local is gitignored — never commit it.

# ── Supabase (optional — Hub works in local mode without these) ──────────
REACT_APP_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
REACT_APP_SUPABASE_ANON_KEY=YOUR-ANON-KEY-HERE

# ── Follow Up Boss API key (required for FUB sync + Auto Video Maker FUB pull)
# Get from app.followupboss.com → Settings → API
FUB_API_KEY=your-fub-api-key-here
REACT_APP_FUB_API_KEY=your-fub-api-key-here

# ── AI Backend — pick at least ONE of the two below ──────────────────────────
# All AI features (Smart Clips, CMA, market reports, listing descriptions,
# captions, Auto Video Maker scripts/hashtags/hooks) route through
# /api/claude/messages, which tries Anthropic first, then falls back to Ollama.
# If both are missing, AI features will fail with a clear error.

# Option A — Anthropic API key (best quality, costs money but very cheap)
# Get from console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Option B — Ollama (free, runs locally on your PC, no signup)
# 1. Install Ollama from ollama.com (1-click Windows installer)
# 2. Open a terminal and run:    ollama pull llama3.2
#    (or a bigger model for better quality: ollama pull qwen2.5:7b)
# 3. Leave Ollama running in the background. That's it — server.js will find it.
# If Ollama runs somewhere other than localhost:11434, set this:
#OLLAMA_URL=http://localhost:11434

# ── ElevenLabs API key (optional — for AI voice synthesis in AI Studio) ──────
# Free tier: 10,000 chars/month, all preset voices. Voice cloning ("sounds like
# YOU") requires the Starter plan at $5/month.
# Get from elevenlabs.io → Settings → API Keys.
#ELEVENLABS_API_KEY=your-elevenlabs-key-here
