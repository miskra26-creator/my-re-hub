# Copy this file to .env.local and fill in your real keys.
# .env.local is gitignored — never commit it.

# ── Supabase (optional — Hub works in local mode without these) ──────────
REACT_APP_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
REACT_APP_SUPABASE_ANON_KEY=YOUR-ANON-KEY-HERE

# ── Follow Up Boss API key (required for FUB sync + Auto Video Maker FUB pull)
# Get from app.followupboss.com → Settings → API
FUB_API_KEY=your-fub-api-key-here
REACT_APP_FUB_API_KEY=your-fub-api-key-here
